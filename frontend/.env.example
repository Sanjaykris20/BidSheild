# ==============================================================================
# BIDSHIELD PLATFORM — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# All statutory verification gateways operate in OPEN_DATA / MOCK / SANDBOX mode
# by default with zero external dependencies, so the application runs immediately.
# When production statutory API credentials are provided, the respective provider
# transitions into LIVE verification mode automatically.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. OFFICIAL GOVERNMENT OPEN DATA SOURCES (Public - No API Key Required)
# ------------------------------------------------------------------------------
# eProcure / CPPP Public Portal Gateway URL (eprocure.gov.in)
# Mode: OPEN_DATA
EPROCURE_PORTAL_URL=https://eprocure.gov.in/eprocure/app
EPROCURE_DEFAULT_MODE=OPEN_DATA

# Open Government Data (data.gov.in) MSME Udyam Catalog Dataset
# Mode: OPEN_DATA
DATA_GOV_IN_UDYAM_URL=https://www.data.gov.in/catalog/udyam-registration-msme-registration
DATA_GOV_IN_API_KEY=
UDYAM_DEFAULT_MODE=OPEN_DATA

# Central Debarment / Blacklist Register (CVC / MoF)
# Mode: OPEN_DATA
DEBARMENT_REGISTRY_URL=https://cvc.gov.in/api/debarment-list
DEBARMENT_DEFAULT_MODE=OPEN_DATA

# ------------------------------------------------------------------------------
# 3. STATUTORY VERIFICATION PROVIDERS (Production / Sandbox API Credentials)
# ------------------------------------------------------------------------------
# GSTN (Goods and Services Tax Network) API
# Mode: LIVE / SANDBOX / MOCK (Default: MOCK)
# Required for LIVE: Obtain client ID and client secret from https://developer.gst.gov.in
GST_API_KEY=
GST_API_SECRET=
GST_API_URL=https://api.gstn.gov.in/v2/authenticate
GST_DEFAULT_MODE=MOCK

# PAN (NSDL / Income Tax Department) Gateway
# Mode: LIVE / SANDBOX / MOCK (Default: MOCK)
# Required for LIVE: Obtain TIN-NSDL or Income Tax e-filing authorization
PAN_API_KEY=
PAN_API_URL=https://api.tin-nsdl.com/pan/verify
PAN_DEFAULT_MODE=MOCK

# Income Tax Return (ITR) Compliance API
# Mode: LIVE / SANDBOX / MOCK (Default: MOCK)
INCOME_TAX_API_KEY=
INCOME_TAX_API_URL=https://eportal.incometax.gov.in/iec/services/v1
INCOME_TAX_DEFAULT_MODE=MOCK

# EPFO (Employees' Provident Fund Organisation) Gateway
# Mode: LIVE / SANDBOX / MOCK (Default: MOCK)
EPFO_API_KEY=
EPFO_API_URL=https://unifiedportal-epfo.gov.in/api/verify
EPFO_DEFAULT_MODE=MOCK

# ESIC (Employees' State Insurance Corporation) Gateway
# Mode: LIVE / SANDBOX / MOCK (Default: MOCK)
ESIC_API_KEY=
ESIC_API_URL=https://esic.gov.in/api/v1/employer-check
ESIC_DEFAULT_MODE=MOCK

# DPIIT Startup India Recognition Registry
# Mode: LIVE / SANDBOX / MOCK (Default: MOCK)
STARTUP_INDIA_API_KEY=
STARTUP_INDIA_API_URL=https://api.startupindia.gov.in/dppit/v1/validate
STARTUP_INDIA_DEFAULT_MODE=MOCK

# NSIC Single Point Registration Scheme (SPRS) Gateway
# Mode: LIVE / SANDBOX / MOCK (Default: MOCK)
NSIC_API_KEY=
NSIC_API_URL=https://nsic.co.in/api/sprs/verify
NSIC_DEFAULT_MODE=MOCK

# OEM Direct Manufacturer Authorization Ledger (GeM / Direct OEM)
# Mode: LIVE / SANDBOX / MOCK (Default: MOCK)
OEM_REGISTRY_API_KEY=
OEM_REGISTRY_API_URL=https://oem-registry.gem.gov.in/v1/auth-check
OEM_DEFAULT_MODE=MOCK

# DigiLocker / MeriPehchan Verification Gateway
# Mode: LIVE / SANDBOX / MOCK (Default: MOCK)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_API_URL=https://digilocker.meripehchan.gov.in/public/api/v2
DIGILOCKER_DEFAULT_MODE=MOCK

# ------------------------------------------------------------------------------
# 4. AI INFERENCE ENGINE (Optional - Fallback to deterministic AI engine)
# ------------------------------------------------------------------------------
# Groq Cloud API Key for Llama-3 70B inference
# If not provided, platform automatically uses deterministic heuristic AI engine
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 5. LOCAL SAFE DOCUMENT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Storage root folder relative to project workspace
STORAGE_UPLOAD_DIR=.uploads
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx
